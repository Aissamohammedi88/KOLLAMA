# ────────────────────────────────────────────────────────────────────────
#  HTTP server : API Ollama-compatible + WebGUI
# ────────────────────────────────────────────────────────────────────────
class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a): pass

    def _send(self, code, body, ctype="application/json"):
        if isinstance(body, (dict, list)): body = json.dumps(body).encode()
        elif isinstance(body, str): body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(body)

    def _body(self):
        n = int(self.headers.get("Content-Length", 0))
        if n: return json.loads(self.rfile.read(n) or b"{}")
        return {}

    def do_GET(self):
        u = urllib.parse.urlparse(self.path)
        p = u.path; q = urllib.parse.parse_qs(u.query)
        if p == "/" or p == "/index.html":
            return self._send(200, WEBGUI, "text/html; charset=utf-8")
        if p == "/api/tags":
            rows = [{"name":r["name"], "size":r["size_bytes"], "repo":r["repo"],
                     "modified":r["added"]} for r in list_models()]
            return self._send(200, {"models":rows})
        if p == "/api/ps":
            return self._send(200, {"models":backend.running()})
        if p == "/api/status":
            return self._send(200, {"identity":"Cousin — Runner LLM","version":VERSION,
                                    "port":SERVER_PORT,"backend":f"llama-server {LLAMA_VER}",
                                    "port_policy":"11435+ (jamais 11434 — le port d'Ollama)",
                                    "models_count":len(list_models())})
        if p == "/api/memory":
            return self._send(200, {"memory":memory_get()})
        if p == "/api/search":
            return self._send(200, {"models":hf_search(q.get("q",[""])[0])})
        if p == "/api/pull":
            return self._handle_pull(q.get("repo",[""])[0])
        # proxy GET vers backend (ex: /health du modèle)
        return self._send(404, {"error":"not found"})

    def do_POST(self):
        u = urllib.parse.urlparse(self.path); p = u.path
        try: b = self._body()
        except Exception: b = {}
        if p == "/api/show":
            m = b.get("model") or b.get("name")
            path = MODELS_DIR / f"{m}.gguf"
            if not path.exists(): return self._send(404, {"error":f"modèle inconnu: {m}"})
            info = gguf_info(path)
            return self._send(200, {"modelfile":f"# Cousin model: {m}\n# Repo: {dict(list_models()) and 'local'}\n",
                                    "details":{"family":info.get("arch","?"),"parameter_size":info.get("parameters_estimate","?"),
                                               "context_length":info.get("context_length","?")},
                                    "info":info})
        if p == "/api/chat" or p == "/v1/chat/completions":
            return self._handle_chat(b, p == "/v1/chat/completions")
        if p == "/api/generate" or p == "/v1/completions":
            return self._handle_generate(b)
        if p == "/api/memory":
            mid = memory_add(b.get("role","user"), b.get("content",""))
            return self._send(200, {"id":mid})
        if p == "/api/stop":
            backend.stop()
            return self._send(200, {"status":"ok","stopped":True})
        if p == "/api/pull":
            return self._handle_pull(b.get("repo",""))
        return self._send(404, {"error":"not found"})

    def do_DELETE(self):
        u = urllib.parse.urlparse(self.path); p = u.path
        if p == "/api/delete":
            b = self._body()
            if remove_model(b.get("model") or b.get("name")): return self._send(200, {"status":"ok"})
            return self._send(404, {"error":"modèle introuvable"})
        if p.startswith("/api/memory/"):
            mid = p.split("/")[-1]
            c = db(); c.execute("DELETE FROM memory WHERE id=?", (mid,)); c.commit(); c.close()
            return self._send(200, {"status":"ok"})
        self._send(404, {"error":"not found"})

    def _handle_pull(self, repo):
        if not repo: return self._send(400, {"error":"repo manquant"})
        self.send_response(200)
        self.send_header("Content-Type","text/event-stream")
        self.send_header("Cache-Control","no-cache")
        self.end_headers()
        def ev(d):
            try: self.wfile.write(f"data: {json.dumps(d)}\n\n".encode()); self.wfile.flush()
            except Exception: pass
        try:
            ev({"status":f"Liste des GGUF de {repo}…"})
            short, path = hf_pull(repo, on_progress=lambda d,t,el: ev({"status":"téléchargement","done":d,"total":t,"elapsed":int(el)}))
            ev({"status":"enregistrement…"})
            ev({"done":True,"name":short})
        except Exception as e:
            ev({"error":str(e)})

    def _handle_chat(self, body, openai_format):
        model = body.get("model")
        if not model: return self._send(400, {"error":"model manquant"})
        port = backend.ensure(model)
        if not port: return self._send(503, {"error":"runner non démarré"})
        # injecte mémoire
        mem = memory_prompt()
        msgs = body.get("messages", [])
        if mem and msgs and msgs[0].get("role") == "system":
            msgs[0]["content"] = msgs[0]["content"] + "\n" + mem
        elif mem:
            msgs = [{"role":"system","content":mem + "Tu es Cousin, l'assistant local du runner (port 11435 — jamais celui d'Ollama). Réponds dans la langue de l'utilisateur, clairement et concis."}] + msgs
        stream = body.get("stream", True)
        # proxy vers llama-server /v1/chat/completions
        data = json.dumps({**body, "messages":msgs, "stream":stream}).encode()
        req = urllib.request.Request(f"http://127.0.0.1:{port}/v1/chat/completions",
                                     data=data, headers={"Content-Type":"application/json"})
        if stream:
            self.send_response(200)
            self.send_header("Content-Type","text/event-stream")
            self.send_header("Cache-Control","no-cache")
            self.end_headers()
            buf = ""
            def emit(d):
                try: self.wfile.write(f"data: {json.dumps(d)}\n\n".encode()); self.wfile.flush()
                except Exception: pass
            try:
                with urllib.request.urlopen(req) as r:
                    for chunk in iter(lambda: r.read(1024), b""):
                        buf += chunk.decode("utf-8","replace")
                        while "\n" in buf:
                            line, buf = buf.split("\n", 1)
                            line = line.strip()
                            if not line.startswith("data: "): continue
                            payload = line[6:]
                            if payload == "[DONE]": continue
                            try: d = json.loads(payload)
                            except Exception: continue
                            # OpenAI → delta content
                            delta = (d.get("choices") or [{}])[0].get("delta",{}).get("content","")
                            if openai_format:
                                self.wfile.write(f"data: {json.dumps(d)}\n\n".encode()); self.wfile.flush()
                            elif delta:
                                emit({"model":model,"created_at":str(int(time.time())),
                                      "message":{"role":"assistant","content":delta},"done":False})
                if openai_format:
                    self.wfile.write(b"data: [DONE]\n\n"); self.wfile.flush()
                else:
                    emit({"model":model,"created_at":str(int(time.time())),
                          "message":{"role":"assistant","content":""},"done":True,
                          "total_duration":0,"eval_count":0})
            except Exception as e:
                emit({"error":str(e)})
        else:
            try:
                with urllib.request.urlopen(req) as r:
                    oai = json.loads(r.read())
                if openai_format:
                    return self._send(200, oai)
                msg = (oai.get("choices") or [{}])[0].get("message",{}).get("content","")
                usage = oai.get("usage",{})
                return self._send(200, {"model":model,"created_at":str(int(time.time())),
                                        "message":{"role":"assistant","content":msg},"done":True,
                                        "eval_count":usage.get("completion_tokens",0),
                                        "prompt_eval_count":usage.get("prompt_tokens",0)})
            except Exception as e:
                self._send(502, {"error":str(e)})

    def _handle_generate(self, body):
        model = body.get("model")
        if not model: return self._send(400, {"error":"model manquant"})
        port = backend.ensure(model)
        if not port: return self._send(503, {"error":"runner non démarré"})
        data = json.dumps(body).encode()
        req = urllib.request.Request(f"http://127.0.0.1:{port}/completion", data=data,
                                     headers={"Content-Type":"application/json"})
        try:
            with urllib.request.urlopen(req) as r:
                self._send(200, r.read(), "application/json")
        except Exception as e:
            self._send(502, {"error":str(e)})

class ThreadingServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True

SERVER_PORT = IDENTITY_PORT
LLAMA_VER = "?"

