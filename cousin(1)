def cmd_stop(args):
    # 1) demande au serveur en ligne d'arrêter ses runners
    stopped = False
    try:
        req = urllib.request.Request(f"http://127.0.0.1:{IDENTITY_PORT}/api/stop", method="POST", data=b"{}",
                                     headers={"Content-Type":"application/json"})
        with urllib.request.urlopen(req, timeout=3) as r:
            if r.status == 200: stopped = True
    except Exception: pass
    # 2) fallback : tue les llama-server persistants
    try:
        subprocess.run(["pkill", "-f", "llama-server"], check=False, timeout=5)
        stopped = True
    except Exception: pass
    if stopped: ok("Runners arrêtés (serveur 11435 laissé en vie).")
    else: say("Aucun runner à arrêter.")

USAGE = f"""{G}Cousin v{VERSION}{N} — Runner LLM local (remplace Ollama)
Identité : port {IDENTITY_PORT} (jamais 11434), home ~/.cousin

{B}Commandes :{N}
  cousin list                    Liste les modèles installés
  cousin pull <owner/repo>       Télécharge un GGUF depuis HuggingFace
  cousin run <modèle>            Chat interactif dans le terminal
  cousin serve [--port N]        Démarre le serveur API + WebGUI (foreground)
  cousin web [--port N]          Idem + ouvre le navigateur
  cousin ps                      Runners actifs
  cousin show <modèle>           Détails d'un modèle (GGUF metadata)
  cousin rm <modèle>             Supprime un modèle
  cousin stop                    Arrête tous les runners
  cousin --version               Version

{B}Exemples :{N}
  cousin pull bartowski/Qwen2.5-0.5B-Instruct-GGUF
  cousin run Qwen2.5-0.5B-Instruct-Q4_K_M
  cousin web                     → http://localhost:{IDENTITY_PORT}

{B}WebGUI :{N}  une fois `cousin serve` lancé, ouvre http://localhost:{IDENTITY_PORT}
{B}API :{N}     Ollama-compatible (/api/tags, /api/chat, /api/generate, /api/ps, …)
"""

def main():
    setup_home()
    args = sys.argv[1:]
    if not args or args[0] in ("-h","--help","help"):
        print(USAGE); return
    if args[0] == "--version" or args[0] == "-v":
        print(f"cousin {VERSION}"); return
    cmd = args[0]; rest = args[1:]
    cmds = {"list":cmd_list,"pull":cmd_pull,"run":cmd_run,"serve":cmd_serve,
            "web":cmd_web,"ps":cmd_ps,"rm":cmd_rm,"show":cmd_show,"stop":cmd_stop}
    if cmd not in cmds: err(f"Commande inconnue : {cmd}"); print(USAGE); sys.exit(1)
    cmds[cmd](rest)

if __name__ == "__main__":
    main()
