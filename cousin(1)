B = "\033[1;34m"; G = "\033[1;32m"; Y = "\033[1;33m"; R = "\033[1;31m"; N = "\033[0m"
def say(x):  print(f"{B}[*]{N} {x}")
def ok(x):   print(f"{G}[OK]{N} {x}")
def warn(x): print(f"{Y}[!]{N}  {x}")
def err(x):  print(f"{R}[X]{N} {x}", file=sys.stderr)

# ────────────────────────────────────────────────────────────────────────
#  Setup home + SQLite
# ────────────────────────────────────────────────────────────────────────
def setup_home():
    for d in (HOME, MODELS_DIR, BIN_DIR, LOG_DIR):
        d.mkdir(parents=True, exist_ok=True)

def db():
    conn = sqlite3.connect(str(DB_PATH))
    conn.row_factory = sqlite3.Row
    conn.executescript("""
        CREATE TABLE IF NOT EXISTS models(name TEXT PRIMARY KEY, size_bytes INTEGER, repo TEXT, added INTEGER);
        CREATE TABLE IF NOT EXISTS servers(model TEXT PRIMARY KEY, pid INTEGER, port INTEGER, started INTEGER);
        CREATE TABLE IF NOT EXISTS memory(id INTEGER PRIMARY KEY AUTOINCREMENT, role TEXT, content TEXT, ts INTEGER);
    """)
    return conn

# ────────────────────────────────────────────────────────────────────────
#  GGUF parser (header only — name, arch, context_length, parameters)
# ────────────────────────────────────────────────────────────────────────
GGUF_TYPES = {0:"u8",1:"i8",2:"u16",3:"i16",4:"u32",5:"i32",6:"f32",7:"bool",8:"str",9:"arr",10:"u64",11:"i64",12:"f64"}
def gguf_info(path):
    try:
        with open(path, "rb") as f:
            magic = f.read(4)
            if magic != b"GGUF": return {"error": "pas un fichier GGUF"}
            ver = struct.unpack("<I", f.read(4))[0]
            n_tensors = struct.unpack("<Q", f.read(8))[0]
            n_kv = struct.unpack("<Q", f.read(8))[0]
            info = {"gguf_version": ver, "tensors": n_tensors}
            def read_val(t):
                if t in (0,1): return struct.unpack("<b", f.read(1))[0] if t==1 else struct.unpack("<B", f.read(1))[0]
                if t in (2,3): return struct.unpack("<H" if t==2 else "<I", f.read(2 if t==2 else 4))[0]
                if t in (4,5): return struct.unpack("<I" if t==4 else "<i", f.read(4))[0]
                if t==6: return struct.unpack("<f", f.read(4))[0]
                if t==7: return bool(f.read(1)[0])
                if t==8:
                    n=struct.unpack("<Q", f.read(8))[0]; return f.read(n).decode("utf-8", "replace")
                if t==9:
                    et=struct.unpack("<I", f.read(4))[0]; n=struct.unpack("<Q", f.read(8))[0]
                    return [read_val(et) for _ in range(n)]
                if t in (10,11): return struct.unpack("<Q" if t==10 else "<q", f.read(8))[0]
                if t==12: return struct.unpack("<d", f.read(8))[0]
            for _ in range(n_kv):
                klen = struct.unpack("<Q", f.read(8))[0]
                key = f.read(klen).decode("utf-8", "replace")
                t = struct.unpack("<I", f.read(4))[0]
                try: val = read_val(t)
                except Exception: val = None
                if key in ("general.name","general.architecture","llama.context_length","llama.block_count","llama.embedding_length","llama.parameter_count","general.file_type"):
                    info[key] = val
            arch = info.get("general.architecture", "?")
            info["arch"] = arch
            info["name"] = info.get("general.name", Path(path).stem)
            info["context_length"] = info.get(f"{arch}.context_length", "?")
            info["file_type"] = info.get("general.file_type", "?")
            # estime paramètres si absent
            if "llama.parameter_count" not in info and "llama.embedding_length" in info:
                emb = info["llama.embedding_length"]; blk = info.get("llama.block_count", 0)
                info["parameters_estimate"] = (emb*emb*blk*12) if blk else "?"
            return info
    except Exception as e:
        return {"error": str(e)}

# ────────────────────────────────────────────────────────────────────────
#  HuggingFace : recherche + pull
# ────────────────────────────────────────────────────────────────────────
HF_API = "https://huggingface.co/api"
def hf_list_files(repo):
    url = f"{HF_API}/models/{urllib.parse.quote(repo)}"
    req = urllib.request.Request(url, headers={"User-Agent":"cousin/2.0"})
    with urllib.request.urlopen(req, timeout=30) as r:
        data = json.loads(r.read())
    return [s["rfilename"] for s in data.get("siblings", []) if s["rfilename"].lower().endswith(".gguf")]

def hf_pick(files):
    """Choisit le meilleur GGUF : Q4_K_M > Q5_K_M > Q4_K_S > premier dispo."""
    pref = ["Q4_K_M","Q5_K_M","Q4_K_S","Q6_K","Q3_K_M","Q4_0","F16"]
    for p in pref:
        m = [f for f in files if p in f]
        if m: return m[0]
    return files[0]

def hf_pull(repo, on_progress=None):
    files = hf_list_files(repo)
    if not files: raise RuntimeError(f"aucun GGUF trouvé dans {repo}")
    fname = hf_pick(files)
    # nom court cousin : <model>-<quant>.gguf sans espaces
    short = Path(fname).stem.replace(" ", "-")
    out = MODELS_DIR / f"{short}.gguf"
    url = f"https://huggingface.co/{repo}/resolve/main/{urllib.parse.quote(fname)}"
    req = urllib.request.Request(url, headers={"User-Agent":"cousin/2.0"})
    total = int(urllib.request.urlopen(req).getheader("Content-Length") or 0) if False else None
    # HEAD pour taille
    hreq = urllib.request.Request(url, headers={"User-Agent":"cousin/2.0"}, method="HEAD")
    try:
        with urllib.request.urlopen(hreq, timeout=30) as hr: total = int(hr.getheader("Content-Length") or 0)
    except Exception: total = 0
    with urllib.request.urlopen(req) as r, open(out, "wb") as w:
        done = 0; t0 = time.time()
        while True:
            chunk = r.read(1024*256)
            if not chunk: break
            w.write(chunk); done += len(chunk)
            if on_progress:
                on_progress(done, total, time.time()-t0)
    # enregistre DB
    c = db(); c.execute("INSERT OR REPLACE INTO models(name,size_bytes,repo,added) VALUES(?,?,?,?)",
                        (short, out.stat().st_size, repo, int(time.time()))); c.commit(); c.close()
    return short, out

def hf_search(q, limit=12):
    url = f"{HF_API}/models?search={urllib.parse.quote(q)}&filter=gguf&limit={limit}"
    req = urllib.request.Request(url, headers={"User-Agent":"cousin/2.0"})
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.loads(r.read())

# ────────────────────────────────────────────────────────────────────────
#  Backend manager — un subprocess llama-server par modèle (type Ollama)
# ────────────────────────────────────────────────────────────────────────
class Backend:
    def __init__(self):
        self.servers = {}   # model -> {proc, port, pid, started, path}
        self.lock = threading.Lock()

    def _free_port(self, model):
        h = int(hashlib.md5(model.encode()).hexdigest()[:6], 16)
        for off in range(200):
            port = BACKEND_BASE_PORT + (h + off) % 200
            with socket.socket() as s:
                try: s.bind(("127.0.0.1", port)); return port
                except OSError: continue
        return BACKEND_BASE_PORT + (h % 200)

    def ensure(self, model):
        with self.lock:
            if model in self.servers and self.servers[model]["proc"].poll() is None:
                return self.servers[model]["port"]
            path = self._model_path(model)
            if not path: raise RuntimeError(f"modèle inconnu : {model}")
            port = self._free_port(model)
            logf = open(LOG_DIR / f"llama-{model}-{port}.log", "wb")
            cmd = [str(LLAMA_SERVER), "--model", str(path), "--host", "127.0.0.1",
                   "--port", str(port), "--n-gpu-layers", "0", "--ctx-size", "4096",
                   "--flash-attn", "auto", "--no-warmup"]
            say(f"Démarrage du runner pour « {model} » (port interne {port})...")
            proc = subprocess.Popen(cmd, stdout=logf, stderr=subprocess.STDOUT, start_new_session=True)
            self.servers[model] = {"proc":proc, "port":port, "pid":proc.pid, "started":int(time.time()), "path":str(path)}
            # attend /health (jusqu'à 90 s)
            for _ in range(90):
                if proc.poll() is not None: break
                try:
                    with urllib.request.urlopen(f"http://127.0.0.1:{port}/health", timeout=1) as r:
                        if r.status == 200:
                            ok(f"Runner prêt ({model}, port {port})")
                            return port
                except Exception: time.sleep(1)
            err(f"Le runner n'a pas démarré — voir {LOG_DIR}/llama-{model}-{port}.log")
            return None

    def _model_path(self, model):
        c = db(); row = c.execute("SELECT * FROM models WHERE name=?", (model,)).fetchone()
        c.close()
        if row: p = MODELS_DIR / f"{model}.gguf"; return p if p.exists() else None
        # scan direct
        p = MODELS_DIR / f"{model}.gguf"
        return p if p.exists() else None

    def port_of(self, model):
        return self.servers.get(model, {}).get("port")

    def running(self):
        out = []
        for m, s in self.servers.items():
            if s["proc"].poll() is None: out.append({"model":m, "port":s["port"], "pid":s["pid"], "started":s["started"]})
        return out

    def stop(self, model=None):
        with self.lock:
            for m in (list(self.servers) if model is None else [model] if model in self.servers else []):
                s = self.servers[m]
                if s["proc"].poll() is None:
                    try: os.killpg(os.getpgid(s["pid"]), signal.SIGTERM)
                    except Exception:
                        try: s["proc"].terminate()
                        except Exception: pass
                self.servers.pop(m, None)
                c = db(); c.execute("DELETE FROM servers WHERE model=?", (m,)); c.commit(); c.close()
                ok(f"Runner arrêté : {m}")

backend = Backend()

# ────────────────────────────────────────────────────────────────────────
#  Modèles : list / scan / register
# ────────────────────────────────────────────────────────────────────────
def scan_models():
    """Enregistre tout .gguf présent dans models/ (drop-file auto)."""
    c = db(); new = []
    for p in MODELS_DIR.glob("*.gguf"):
        name = p.stem
        if not c.execute("SELECT 1 FROM models WHERE name=?", (name,)).fetchone():
            c.execute("INSERT OR REPLACE INTO models(name,size_bytes,repo,added) VALUES(?,?,?,?)",
                      (name, p.stat().st_size, "fichier local déposé", int(time.time())))
            new.append(name)
    c.commit(); c.close()
    return new

def list_models():
    scan_models()
    c = db(); rows = c.execute("SELECT * FROM models ORDER BY added DESC").fetchall(); c.close()
    return rows

def remove_model(name):
    c = db()
    if not c.execute("SELECT 1 FROM models WHERE name=?", (name,)).fetchone():
        c.close(); return False
    backend.stop(name)
    p = MODELS_DIR / f"{name}.gguf"
    if p.exists(): p.unlink()
    c.execute("DELETE FROM models WHERE name=?", (name,)); c.commit(); c.close()
    return True

def memory_get():
    c = db(); rows = c.execute("SELECT * FROM memory ORDER BY id DESC LIMIT 50").fetchall(); c.close()
    return [dict(r) for r in rows]

def memory_add(role, content):
    c = db(); c.execute("INSERT INTO memory(role,content,ts) VALUES(?,?,?)", (role, content, int(time.time())))
    c.commit(); id_ = c.execute("SELECT last_insert_rowid()").fetchone()[0]; c.close(); return id_

def memory_prompt():
    rows = memory_get()
    if not rows: return ""
    lines = [f"[{r['role']}] {r['content']}" for r in reversed(rows)]
    return "Mémoire persistante de l'utilisateur :\n" + "\n".join(lines) + "\n"

