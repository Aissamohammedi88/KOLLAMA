def cmd_list(args):
    rows = list_models()
    if not rows: say("Aucun modèle. Dépose un .gguf dans ~/.cousin/models/ ou : cousin pull <owner/repo>"); return
    print(f"\n{G}MODÈLE{' '*34}TAILLE{' '*8}DÉPÔT{N}")
    for r in rows:
        sz = f"{r['size_bytes']/1024/1024:.1f} Mo" if r['size_bytes'] else "?"
        print(f"  {r['name']:<40} {sz:<14} {r['repo']}")

def cmd_pull(args):
    if not args: err("Usage: cousin pull <owner/repo>  (ex: bartowski/Qwen2.5-0.5B-Instruct-GGUF)"); sys.exit(1)
    repo = args[0]
    def prog(d, t, el):
        if t: pct = d*100//t
        else: pct = 0
        bar = "█"*min(40, max(1, pct//3)) + "░"*(40 - min(40, max(1, pct//3)))
        print(f"\r{B}[{bar}]{N} {d//1024//1024} / {t//1024//1024 or '?'} Mo ({pct}%)   ", end="", flush=True)
    say(f"Pull depuis HuggingFace : {repo}")
    short, path = hf_pull(repo, on_progress=prog)
    print()
    ok(f"Modèle installé : {short}  ({path.stat().st_size//1024//1024} Mo)")
    print(f"  Lance : cousin run {short}")

def cmd_run(args):
    if not args: err("Usage: cousin run <modèle>"); sys.exit(1)
    model = args[0]
    setup_home(); scan_models()
    port = backend.ensure(model)
    if not port: sys.exit(1)
    say(f"Chat avec {model} (Ctrl+D pour quitter). Mémoire active.")
    hist = []
    mem = memory_prompt()
    if mem: hist.append({"role":"system","content":mem + "Tu es Cousin, l'assistant local du runner (port 11435). Réponds dans la langue de l'utilisateur, clairement et concis."})
    print()
    while True:
        try: line = input(f"{G} toi > {N}")
        except (EOFError, KeyboardInterrupt): print("\nAu revoir."); break
        if not line: continue
        hist.append({"role":"user","content":line})
        sys.stdout.write(f"{B} cousin > {N}")
        sys.stdout.flush()
        data = json.dumps({"model":model,"messages":hist,"stream":True}).encode()
        req = urllib.request.Request(f"http://127.0.0.1:{port}/v1/chat/completions",
                                     data=data, headers={"Content-Type":"application/json"})
        full = ""
        try:
            with urllib.request.urlopen(req) as r:
                for chunk in iter(lambda: r.read(1024), b""):
                    for line in chunk.decode("utf-8","replace").split("\n"):
                        if line.startswith("data: ") and line != "data: [DONE]":
                            try:
                                d = json.loads(line[6:])
                                c = d.get("choices",[{}])[0].get("delta",{}).get("content","")
                                if c: sys.stdout.write(c); sys.stdout.flush(); full += c
                            except Exception: pass
        except Exception as e:
            sys.stdout.write(f"\n[erreur: {e}]")
        print("\n")
        hist.append({"role":"assistant","content":full})

def cmd_serve(args, open_browser=False):
    global SERVER_PORT, LLAMA_VER
    SERVER_PORT = IDENTITY_PORT
    for i, a in enumerate(args):
        if a == "--port" and i+1 < len(args): SERVER_PORT = int(args[i+1])
    if SERVER_PORT == 11434:
        err("11434 est le port d'Ollama — Cousin vit sur 11435 (identité)."); sys.exit(1)
    setup_home(); scan_models()
    try:
        r = subprocess.run([str(LLAMA_SERVER), "--version"], capture_output=True, text=True, timeout=5)
        LLAMA_VER = (r.stdout + r.stderr).strip().split("\n")[0]
    except Exception: LLAMA_VER = "?"
    try:
        srv = ThreadingServer(("0.0.0.0", SERVER_PORT), Handler)
    except OSError as e:
        err(f"Port {SERVER_PORT} indisponible : {e}"); sys.exit(1)
    def stop(*_): backend.stop(); sys.exit(0)
    signal.signal(signal.SIGINT, stop); signal.signal(signal.SIGTERM, stop)
    print(f"\n{G}══════════════════════════════════════════════════════════════{N}")
    print(f"{G}  🕊️  COUSIN v{VERSION} — Runner LLM en ligne{N}")
    print(f"{G}══════════════════════════════════════════════════════════════{N}")
    print(f"  WebGUI      : {B}http://localhost:{SERVER_PORT}{N}")
    print(f"  API OpenAI  : {B}http://localhost:{SERVER_PORT}/v1/chat/completions{N}")
    print(f"  Port        : {SERVER_PORT} — {G}NOTRE identité{N} (jamais 11434 d'Ollama)")
    print(f"  Backend     : llama-server {LLAMA_VER}")
    print(f"  Modèles     : {len(list_models())}  (dépose un .gguf dans ~/.cousin/models/)")
    print(f"  Arrêt       : Ctrl+C  (ou : cousin stop)")
    print(f"{G}══════════════════════════════════════════════════════════════{N}\n")
    if open_browser:
        try: subprocess.Popen(["xdg-open", f"http://localhost:{SERVER_PORT}"])
        except Exception: pass
    srv.serve_forever()

def cmd_web(args): cmd_serve(args, open_browser=True)

def cmd_ps(args):
    # interroge le serveur en ligne (comme ollama ps)
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{IDENTITY_PORT}/api/ps", timeout=2) as r:
